# ========== 阿里云百炼 / DashScope (文档解析 + OCR + Embedding + Reranker) ==========
BAILIAN_API_KEY=your_bailian_api_key_here
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== 智谱 GLM (图片理解 + 联网搜索) ==========
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_WEB_SEARCH_ENABLED=true

# ========== DeepSeek (主LLM) ==========
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========== OpenAI 兼容 (备用) ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ========== 模型配置 (以下为默认值, 通常无需修改) ==========
# OCR_MODEL=qwen-vl-ocr-2025-08-28
# EMBEDDING_MODEL=qwen2.5-vl-embedding
# EMBEDDING_DIM=2048
# RERANKER_MODEL=qwen3-vl-rerank

# ========== 向量数据库 Milvus ==========
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=your_milvus_password_here      # 必填（compose 强制）

# ========== Milvus 对象存储 MinIO (docker-compose-milvus.yml 使用) ==========
MINIO_ACCESS_KEY=your_minio_access_key_here    # 必填（compose 强制）
MINIO_SECRET_KEY=your_minio_secret_key_here    # 必填（compose 强制）

# ========== Redis 缓存 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ========== 订单/物流数据库 MySQL (copilot 库，只读账号) ==========
MYSQL_HOST=your_mysql_host_here                # 必填（compose 强制，例如 192.168.x.x）
MYSQL_PORT=3306
MYSQL_USER=agent_ro                            # 必填（compose 强制，只读账号）
MYSQL_PASSWORD=your_mysql_password_here        # 必填（compose 强制）
MYSQL_DATABASE=copilot

# ========== 联网搜索 ==========
WEB_SEARCH_ENABLED=true
# TAVILY_API_KEY=your_tavily_api_key_here  # 可选，Tavily Search API

# ========== 服务端口 ==========
API_HOST=0.0.0.0
API_PORT=8000

# ========== 鉴权 (模块33 JWT) ==========
# 必填（compose 强制）：为空则应用启动校验拒绝启动
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=720

# 是否启用内置 demo 用户（明文弱密码，仅演示/测试）。生产必须 false。
ENABLE_DEMO_USERS=true

# demo 用户 (JSON 字符串): 密码/角色/内容等级；仅在 ENABLE_DEMO_USERS=true 时生效
# role: admin|vip|member|normal ; access_level: vip|member|public (层级 public<member<vip)
# DEMO_USERS={"admin":{"password":"admin123","role":"admin","access_level":"vip"},"vip":{"password":"vip123","role":"vip","access_level":"vip"},"member":{"password":"member123","role":"member","access_level":"member"},"normal":{"password":"normal123","role":"normal","access_level":"public"}}

# ========== Gradio UI 访问鉴权 (三个 UI 端口 7860/7861/7862) ==========
# 必填（compose 强制）：为空则 UI 拒绝无鉴权启动
GRADIO_USERNAME=admin
GRADIO_PASSWORD=your_gradio_password_here

# ========== UI 内部调用 API 的服务账号 ==========
# chat-ui 用普通用户账号、admin-ui 用 admin 账号（配合 ENABLE_DEMO_USERS=true 时用 demo 账号）
API_USERNAME=admin
API_PASSWORD=your_api_account_password_here

# ========== CORS 白名单 (逗号分隔) ==========
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:7860,http://localhost:7861,http://localhost:7862
